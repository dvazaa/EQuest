# =====================================================================
# EQuest Backend Server Environment Variables (.env.example)
# =====================================================================

PORT=3000
NODE_ENV=development

# Konfigurasi Database Fisik MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=equest_db

# Keamanan Autentikasi (JWT)
JWT_SECRET=equest_super_secret_jwt_key_2026

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
