# =====================================================================
# EQuest Environment Variables Template (.env.example)
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi sistem
# =====================================================================

# Server Port
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=equest_db

# JWT Secret for Authentication
JWT_SECRET=equest_super_secret_jwt_key_2026

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage (Opsional untuk upload gambar)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
